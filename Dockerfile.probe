# Diagnostic only — not used by the app. Delete once the build is green.
# Replicates deps + builder exactly, but captures `next build` output and
# serves it, since the panel API never returns stderr.
FROM node:22-bookworm-slim
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_SITE_URL=""
ARG NEXT_PUBLIC_COFFEE_URL=""
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_COFFEE_URL=$NEXT_PUBLIC_COFFEE_URL
RUN { echo "=== free"; free -m || true; \
      echo "=== next build"; npm run build; echo "BUILD_EXIT=$?"; } > /diag.log 2>&1 || echo "FAILED_EXIT=$?" >> /diag.log
CMD ["node","-e","const fs=require('fs');require('http').createServer((_,r)=>{r.setHeader('content-type','text/plain');r.end(fs.readFileSync('/diag.log','utf8'))}).listen(3000,'0.0.0.0')"]
