# Diagnostic only — not used by the app. Delete once the build is green.
#
# The panel's API returns only the failed command, never its stderr, so this
# runs the real deps step with output captured to a file and then serves that
# file over HTTP. The build itself must not fail, hence the `|| true`.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json* ./
RUN { echo "=== node/npm"; node -v; npm -v; \
      echo "=== npm ci"; npm ci; echo "NPM_CI_EXIT=$?"; } > /diag.log 2>&1 || echo "FAILED_EXIT=$?" >> /diag.log
CMD ["node","-e","const fs=require('fs');require('http').createServer((_,r)=>{r.setHeader('content-type','text/plain');r.end(fs.readFileSync('/diag.log','utf8'))}).listen(3000,'0.0.0.0')"]
