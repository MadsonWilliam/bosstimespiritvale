# Diagnostic only — not used by the app.
# Step 1 (passed): base image pulls and runs.
# Step 2 (this):   does the build stage have outbound network for apt and npm?
FROM node:22-bookworm-slim
RUN node -e "console.log('base ok', process.version, 'npm follows')"
RUN npm -v
RUN apt-get update && echo "APT-OK"
RUN npm view next version && echo "NPM-REGISTRY-OK"
CMD ["node", "-e", "require('http').createServer((_,r)=>r.end('probe')).listen(3000)"]
